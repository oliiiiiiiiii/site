---
import SiteIcon from './SiteIcon.astro';
---
<header class="top-navigation">
  <button class="icon-button mobile-menu" type="button" aria-label="Open navigation" aria-controls="app-sidebar" data-sidebar-open><SiteIcon name="menu" /></button>
  <a class="mobile-wordmark" href="/">Oli's Blog</a>
  <nav aria-label="Quick navigation">
    <a href="/notes/">notes/</a>
    <a href="/posts/">posts/</a>
  </nav>
  <button class="icon-button theme-toggle" type="button" aria-label="Toggle color theme" data-theme-toggle>
    <span class="theme-sun"><SiteIcon name="sun" /></span><span class="theme-moon"><SiteIcon name="moon" /></span>
  </button>
</header>

<script>
  const nav = document.querySelector<HTMLElement>('.top-navigation');
  if (nav) {
    const SHOW_DELAY = 400; // ms of continuous upward scrolling before the bar comes back
    const root = document.documentElement;
    let lastY = window.scrollY;
    let showTimer: number | undefined;
    let ticking = false;

    const setHidden = (hidden: boolean) => {
      nav.classList.toggle('is-hidden', hidden);
      const pinned = !hidden && window.scrollY > nav.offsetHeight;
      root.style.setProperty('--nav-offset', pinned ? `${nav.offsetHeight}px` : '0px');
    };
    const clearShow = () => { window.clearTimeout(showTimer); showTimer = undefined; };

    const update = () => {
      ticking = false;
      const y = window.scrollY;
      const delta = y - lastY;
      lastY = y;
      if (y <= nav.offsetHeight) { clearShow(); setHidden(false); return; }
      if (delta > 0) { clearShow(); setHidden(true); }
      else if (delta < 0 && nav.classList.contains('is-hidden') && showTimer === undefined) {
        showTimer = window.setTimeout(() => { showTimer = undefined; setHidden(false); }, SHOW_DELAY);
      }
    };

    window.addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    }, { passive: true });
    // keyboard focus should always reveal the bar
    nav.addEventListener('focusin', () => { clearShow(); setHidden(false); });
  }
</script>

<style>
  .top-navigation { position: sticky; top: 0; z-index: 20; background: var(--paper); box-shadow: 0 0 0 100vmax var(--paper); clip-path: inset(0 -100vmax); transition: transform .3s ease; width: min(calc(100% - 3rem), var(--content-max)); min-height: 72px; margin-inline: auto; display: flex; align-items: center; justify-content: flex-end; gap: 1.25rem; border-bottom: 1px solid var(--line); }
  .top-navigation.is-hidden { transform: translateY(-100%); }
  @media (prefers-reduced-motion: reduce) { .top-navigation { transition: none; } }
  nav { display: flex; gap: 1.5rem; }
  nav a { color: var(--ink-soft); font-family: var(--font-mono); text-decoration: none; font-size: .72rem; font-weight: 700; }
  nav a:hover { color: var(--teal); }
  .icon-button { width: 42px; height: 42px; padding: 0; display: grid; place-items: center; color: var(--ink); background: transparent; border: 1px solid var(--line); border-radius: 50%; cursor: pointer; }
  .icon-button:hover { background: var(--surface-2); }
  .mobile-menu, .mobile-wordmark { display: none; }
  .theme-sun { display: inline-flex; align-items: center; justify-content: center; line-height: 0; }
  .theme-moon { display: none; align-items: center; justify-content: center; line-height: 0; }
  :global(:root[data-theme="dark"]) .theme-sun { display: none; }
  :global(:root[data-theme="dark"]) .theme-moon { display: inline-flex; }
  @media (min-width: 1021px) {
    :global(html.sidebar-collapsed) .top-navigation { justify-content: space-between; }
    :global(html.sidebar-collapsed) .mobile-menu { display: grid; }
    :global(html.sidebar-collapsed) .mobile-wordmark { display: block; margin-right: auto; color: var(--ink); font-family: var(--font-mono); font-weight: 800; text-decoration: none; }
  }
  @media (max-width: 1020px) {
    .top-navigation { justify-content: space-between; }
    .mobile-menu { display: grid; }
  .mobile-wordmark { display: block; margin-right: auto; color: var(--ink); font-family: var(--font-mono); font-weight: 800; text-decoration: none; }
  }
  @media (max-width: 620px) { .top-navigation { width: calc(100% - 2rem); } nav { display: none; } }
  :global(body.layout-wide) .top-navigation { width: min(calc(100% - 3rem), var(--wide-max)); }
  @media (max-width: 620px) { :global(body.layout-wide) .top-navigation { width: calc(100% - 2rem); } }
</style>
